<?xml version="1.0" encoding="utf-8"?>
<!-- kafelek kategorii w siatce 2 kolumn -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/category_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:elevation="6dp">

    <TextView
        android:id="@+id/tvMonogram"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="A"
        android:fontFamily="@font/space_grotesk_bold"
        android:textColor="#F5B04C"
        android:textSize="14sp"
        android:background="@drawable/monogram_bg"/>

    <TextView
        android:id="@+id/tvCategoryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:text="KATEGORIA"
        android:fontFamily="@font/manrope_bold"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.03"
        android:maxLines="2"
        android:ellipsize="end"/>

</LinearLayout>
