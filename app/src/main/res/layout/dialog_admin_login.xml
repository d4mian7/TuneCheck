<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="28dp"
    android:background="@drawable/admin_dialog_bg">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/icon_tile_bg"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_admin_lock"
            android:importantForAccessibility="no"/>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PANEL ADMINA"
        android:fontFamily="@font/space_grotesk_bold"
        android:textColor="#F5B04C"
        android:textSize="24sp"
        android:letterSpacing="0.05"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etAdminLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Login"
        android:inputType="text"
        android:fontFamily="@font/manrope"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB"
        android:background="@drawable/input_style"
        android:padding="14dp"
        android:layout_marginBottom="14dp"/>

    <EditText
        android:id="@+id/etAdminPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Hasło"
        android:inputType="textPassword"
        android:fontFamily="@font/manrope"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB"
        android:background="@drawable/input_style"
        android:padding="14dp"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:id="@+id/tvLoginError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nieprawidłowy login lub hasło"
        android:fontFamily="@font/manrope_semibold"
        android:textColor="#EF5350"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="14dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAdminLogin"
            android:backgroundTint="@null"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="ZALOGUJ"
        android:textAllCaps="true"
        android:fontFamily="@font/manrope_extrabold"
        android:textSize="15sp"
        android:letterSpacing="0.12"
        android:textColor="#1A1A2B"
        android:background="@drawable/btn_primary_gold"
        android:stateListAnimator="@null"/>

</LinearLayout>
