<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rap">

    <!-- przyciemnienie -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C12101D"/>

    <!-- główna zawartość -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TUNECHECK"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#A6FFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.35"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WYBIERZ KATEGORIĘ"
            android:fontFamily="@font/space_grotesk_bold"
            android:textColor="#F5B04C"
            android:textSize="27sp"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="6"
            android:shadowRadius="10"
            android:layout_marginBottom="10dp"/>

        <View
            android:layout_width="56dp"
            android:layout_height="3dp"
            android:background="#F5B04C"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:id="@+id/layoutCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"/>

    </LinearLayout>

    <!-- spinner ładowania -->
    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="#F5B04C"
        android:visibility="visible"/>

</FrameLayout>
