<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rap">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PYTANIA"
            android:fontFamily="@font/space_grotesk_bold"
            android:textColor="#F5B04C"
            android:textSize="26sp"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

        <!-- Wybór kategorii -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WYBIERZ KATEGORIĘ"
            android:fontFamily="@font/manrope_bold"
            android:letterSpacing="0.1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_style"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:popupBackground="#1A1A2B"/>

        <!-- Przycisk dodaj pytanie -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddQuestion"
            android:backgroundTint="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DODAJ PYTANIE"
            android:textAllCaps="false"
            android:fontFamily="@font/manrope_extrabold"
            android:textColor="#1A1A2B"
            android:textSize="15sp"
            android:letterSpacing="0.1"
            android:drawableStart="@drawable/ic_plus"
            android:drawablePadding="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center"
            android:background="@drawable/btn_primary_gold"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <!-- Licznik pytań -->
        <TextView
            android:id="@+id/tvQuestionCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PYTANIA: 0"
            android:fontFamily="@font/manrope_bold"
            android:letterSpacing="0.1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <!-- Lista pytań -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/questionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:backgroundTint="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Powrót"
            android:textAllCaps="false"
            android:fontFamily="@font/manrope_semibold"
            android:drawableStart="@drawable/ic_back"
            android:drawablePadding="6dp"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:layout_marginTop="12dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</FrameLayout>