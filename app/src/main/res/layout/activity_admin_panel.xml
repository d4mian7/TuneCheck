<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rap">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B312101D"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:padding="28dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/admin_panel_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANEL ADMINA"
            android:fontFamily="@font/space_grotesk_bold"
            android:textColor="#F5B04C"
            android:textSize="28sp"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zarządzaj quizem"
            android:fontFamily="@font/manrope"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManageCategories"
            android:backgroundTint="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zarządzaj kategoriami"
            android:textAllCaps="false"
            android:fontFamily="@font/manrope_bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/admin_button_bg"
            android:drawableStart="@drawable/ic_folder"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="14dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:gravity="center_vertical|start"
            android:layout_marginBottom="14dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManageQuestions"
            android:backgroundTint="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zarządzaj pytaniami"
            android:textAllCaps="false"
            android:fontFamily="@font/manrope_bold"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/admin_button_bg"
            android:drawableStart="@drawable/ic_help_circle"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="14dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:gravity="center_vertical|start"
            android:layout_marginBottom="22dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdminBack"
            android:backgroundTint="@null"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="WYLOGUJ"
            android:textAllCaps="true"
            android:fontFamily="@font/manrope_extrabold"
            android:textSize="14sp"
            android:letterSpacing="0.12"
            android:textColor="#EF5350"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_logout"
            android:drawablePadding="8dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</FrameLayout>
