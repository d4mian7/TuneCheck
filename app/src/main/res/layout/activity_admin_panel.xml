<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rap">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:padding="28dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/admin_panel_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANEL ADMINA"
            android:textColor="#F5B04C"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zarządzaj quizem"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnManageCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📂  Zarządzaj kategoriami"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/admin_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnManageQuestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❓  Zarządzaj pytaniami"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/admin_button_bg"
            android:padding="18dp"
            android:layout_marginBottom="24dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/btnAdminBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WYLOGUJ"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:textColor="#FF8888"
            android:background="@android:color/transparent"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

    </LinearLayout>

</FrameLayout>