<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_rap">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/admin_panel_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOWE PYTANIE"
                android:textColor="#F5B04C"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kategoria: ..."
                android:textColor="#BBBBBB"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <!-- Treść pytania -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Treść pytania"
                android:textColor="#F5B04C"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Wpisz pytanie..."
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:background="@drawable/input_style"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

            <!-- Odpowiedź A -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odpowiedź A"
                android:textColor="#F5B04C"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etAnswerA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Odpowiedź A"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:background="@drawable/input_style"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <!-- Odpowiedź B -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odpowiedź B"
                android:textColor="#F5B04C"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etAnswerB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Odpowiedź B"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:background="@drawable/input_style"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <!-- Odpowiedź C -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odpowiedź C"
                android:textColor="#F5B04C"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etAnswerC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Odpowiedź C"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:background="@drawable/input_style"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <!-- Odpowiedź D -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odpowiedź D"
                android:textColor="#F5B04C"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etAnswerD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Odpowiedź D"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#BBBBBB"
                android:background="@drawable/input_style"
                android:padding="14dp"
                android:layout_marginBottom="16dp"/>

            <!-- Poprawna odpowiedź -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Poprawna odpowiedź"
                android:textColor="#F5B04C"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spinnerCorrectAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_style"
                android:padding="14dp"
                android:layout_marginBottom="24dp"
                android:popupBackground="#1A1A2B"/>

            <!-- Przyciski -->
            <Button
                android:id="@+id/btnSaveQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ZAPISZ PYTANIE"
                android:textColor="#1A1A2B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/btn_add_bg"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ANULUJ"
                android:textAllCaps="true"
                android:textColor="#BBBBBB"
                android:textSize="14sp"
                android:background="@android:color/transparent"
                android:minHeight="0dp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>