<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#F5B04C"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#663A2C7A"/>
            <corners android:radius="24dp"/>
            <stroke
                android:width="2dp"
                android:color="#F5B04C"/>
        </shape>
    </item>

</selector>