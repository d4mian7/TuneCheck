<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#35305A" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#FFD98A" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#E01E1B2E" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#F5B04C" />
        </shape>
    </item>
</selector>
