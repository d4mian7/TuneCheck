<?xml version="1.0" encoding="utf-8"?>
<!-- pozycja na rozwiniętej liście: dotknięta = fiolet, wybrana = delikatne złoto -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp"
            android:insetTop="2dp" android:insetBottom="2dp">
            <shape>
                <solid android:color="#35305A"/>
                <corners android:radius="10dp"/>
            </shape>
        </inset>
    </item>
    <item android:state_checked="true">
        <inset android:insetLeft="6dp" android:insetRight="6dp"
            android:insetTop="2dp" android:insetBottom="2dp">
            <shape>
                <solid android:color="#26F5B04C"/>
                <corners android:radius="10dp"/>
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
