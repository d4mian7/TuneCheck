<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#4A3A9C" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#FFD98A" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#8C1A1A2B" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#A6F5B04C" />
        </shape>
    </item>
</selector>
