<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#4A3A9C" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#FFD98A" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#593A2C7A" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#F5B04C" />
        </shape>
    </item>
</selector>
